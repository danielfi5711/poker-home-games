# Copy to .env for local development. None of these are required to run
# locally — without them the app just persists to data/sessions.json.

NODE_ENV=development
PORT=8080
# Base URL this app is reached at. Leave blank locally; Render sets its own
# RENDER_EXTERNAL_URL automatically in production.
PUBLIC_URL=

# Optional: hosted libSQL (Turso, free tier) so session/game history survives
# a redeploy on a host with an ephemeral filesystem (e.g. Render). Without
# these, data is stored in data/sessions.json, which does NOT survive a
# redeploy on Render's free plan.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Web Push (VAPID) keys so hosts get a push notification when a
# player requests a buy-in. Generate a pair with `npx web-push generate-vapid-keys`
# and use the SAME pair everywhere (local .env and Render) — these identify
# this server to push services, not a per-device secret. Without them, the
# app works fine; hosts just won't get pushed until they reopen it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
